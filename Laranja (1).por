programa {
  funcao inicio() {
    //entendimento do problema
    //Calcule, com base nos dados acima, quantas laranjas foram vendidas, vendidos esperando
    //informações e varíaveis
    real quantidade
    real laranja 
    real vendidos
    //estrada de dados
    escreva("Quantidade de laranja inicial: ")
    leia(laranja)
    escreva("quantidade final de laranjas: ")
    leia(quantidade)
    escreva("quantidade de vendidos: ")
    //processamento
    vendidos= laranja - quantidade
    //saida
    escreva(vendidos)

  }
}
