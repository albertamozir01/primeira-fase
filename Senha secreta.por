programa {
  funcao inicio() {
  //problema
  //peça ao usuário para digitar uma senha e , se a senha for "abracadabra", exiba uma mensagem secreta.
  cadeia senha
  cadeia abracadabra
  escreva("digite a sua senha: ")
  leia(senha)
  se(senha== "abracadabra"){
  }
    escreva("acesso  senha secreta")
    leia(abracadabra)
  }
}
